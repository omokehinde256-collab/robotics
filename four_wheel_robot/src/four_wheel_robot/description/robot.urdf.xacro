<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="four_wheel_robot">

  <!-- ========================================================================= -->
  <!-- Master Robot Xacro Description Entry Point                                -->
  <!-- ========================================================================= -->

  <!-- Inertial Calculation Macros -->
  <xacro:include filename="inertial_macros.xacro"/>

  <!-- Base Link and Chassis -->
  <xacro:include filename="chassis.xacro"/>

  <!-- Wheel Links and Joints -->
  <xacro:include filename="wheels.xacro"/>

  <!-- Gazebo Simulation & Physics Plugins -->
  <xacro:include filename="gazebo.xacro"/>

  <!-- ros2_control Hardware Interfaces -->
  <xacro:include filename="ros2_control.xacro"/>

</robot>
