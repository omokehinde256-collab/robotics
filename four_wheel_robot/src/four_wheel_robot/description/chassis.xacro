<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================================= -->
  <!-- Properties: Chassis Dimensions and Mass                                   -->
  <!-- Length (X): 0.60 m                                                        -->
  <!-- Width  (Y): 0.40 m                                                        -->
  <!-- Height (Z): 0.15 m                                                        -->
  <!-- Mass   (M): 15.0 kg                                                       -->
  <!-- Ground Clearance: 0.075 m (Chassis offset Z: 0.05 m above wheel axis)     -->
  <!-- ========================================================================= -->
  <xacro:property name="chassis_length" value="0.60"/>
  <xacro:property name="chassis_width"  value="0.40"/>
  <xacro:property name="chassis_height" value="0.15"/>
  <xacro:property name="chassis_mass"   value="15.0"/>
  <xacro:property name="chassis_offset_z" value="0.05"/>

  <!-- ========================================================================= -->
  <!-- Base Link: The kinematic origin (centered between wheel axles)            -->
  <!-- Placed at wheel axis height (z = 0.10m above ground plane)                -->
  <!-- ========================================================================= -->
  <link name="base_link">
  </link>

  <!-- ========================================================================= -->
  <!-- Chassis Link & Joint                                                      -->
  <!-- ========================================================================= -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <!-- Main Body Visual -->
    <visual>
      <origin xyz="0 0 ${chassis_offset_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>

    <!-- Top Accent Plate Visual -->
    <visual>
      <origin xyz="0 0 ${chassis_offset_z + chassis_height/2.0 + 0.005}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length * 0.85} ${chassis_width * 0.85} 0.01"/>
      </geometry>
      <material name="accent_orange">
        <color rgba="0.95 0.45 0.05 1.0"/>
      </material>
    </visual>

    <!-- Main Body Collision -->
    <collision>
      <origin xyz="0 0 ${chassis_offset_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Main Body Inertia -->
    <xacro:box_inertia m="${chassis_mass}" x_len="${chassis_length}" y_len="${chassis_width}" z_len="${chassis_height}">
      <origin xyz="0 0 ${chassis_offset_z}" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

</robot>
