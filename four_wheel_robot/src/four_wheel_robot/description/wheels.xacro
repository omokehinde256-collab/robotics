<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================================= -->
  <!-- Wheel Properties                                                          -->
  <!-- Radius: 0.10 m, Width: 0.05 m, Mass: 2.5 kg                               -->
  <!-- Wheel Separation: 0.44 m (Y-offset = +/- 0.22 m)                          -->
  <!-- Wheelbase: 0.40 m (X-offset = +/- 0.20 m)                                 -->
  <!-- ========================================================================= -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_mass"   value="2.5"/>

  <xacro:property name="wheel_offset_x" value="0.20"/>
  <xacro:property name="wheel_offset_y" value="0.22"/>

  <!-- ========================================================================= -->
  <!-- Wheel Macro                                                               -->
  <!-- Creates a single continuous wheel joint and wheel link.                   -->
  <!-- Cylinder is oriented along Y-axis to match joint rotation axis (0, 1, 0). -->
  <!-- ========================================================================= -->
  <xacro:macro name="wheel" params="prefix parent_link x_offset y_offset">
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_offset} ${y_offset} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <!-- Visual Geometry: Cylinder aligned with Y-axis -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="matte_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <!-- Rim / Hub Visual Accent -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.5}" length="${wheel_width + 0.002}"/>
        </geometry>
        <material name="metallic_silver">
          <color rgba="0.75 0.75 0.78 1.0"/>
        </material>
      </visual>

      <!-- Collision Geometry -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Dynamic Inertia Calculation -->
      <xacro:cylinder_inertia_y m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:cylinder_inertia_y>
    </link>

  </xacro:macro>

  <!-- ========================================================================= -->
  <!-- Instantiate the 4 Wheels                                                  -->
  <!-- ========================================================================= -->
  
  <!-- Front Left Wheel -->
  <xacro:wheel prefix="front_left" parent_link="base_link" x_offset="${wheel_offset_x}" y_offset="${wheel_offset_y}"/>

  <!-- Front Right Wheel -->
  <xacro:wheel prefix="front_right" parent_link="base_link" x_offset="${wheel_offset_x}" y_offset="-${wheel_offset_y}"/>

  <!-- Rear Left Wheel -->
  <xacro:wheel prefix="rear_left" parent_link="base_link" x_offset="-${wheel_offset_x}" y_offset="${wheel_offset_y}"/>

  <!-- Rear Right Wheel -->
  <xacro:wheel prefix="rear_right" parent_link="base_link" x_offset="-${wheel_offset_x}" y_offset="-${wheel_offset_y}"/>

</robot>
