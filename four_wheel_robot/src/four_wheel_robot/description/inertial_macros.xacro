<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================================= -->
  <!-- Inertial Macro: Solid Box                                                 -->
  <!-- Dimensions: x_len (Length), y_len (Width), z_len (Height)                 -->
  <!-- Equations:                                                                -->
  <!--   Ixx = (1/12) * m * (y^2 + z^2)                                          -->
  <!--   Iyy = (1/12) * m * (x^2 + z^2)                                          -->
  <!--   Izz = (1/12) * m * (x^2 + y^2)                                          -->
  <!-- ========================================================================= -->
  <xacro:macro name="box_inertia" params="m x_len y_len z_len *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (y_len*y_len + z_len*z_len)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12.0) * (x_len*x_len + z_len*z_len)}" iyz="0.0"
               izz="${(m/12.0) * (x_len*x_len + y_len*y_len)}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================================================= -->
  <!-- Inertial Macro: Solid Cylinder oriented along Y-axis                      -->
  <!-- Radius: r, Length (Thickness): l, Mass: m                                 -->
  <!-- Equations:                                                                -->
  <!--   Ixx = (1/12) * m * (3*r^2 + l^2)                                        -->
  <!--   Iyy = (1/2)  * m * r^2                                                  -->
  <!--   Izz = (1/12) * m * (3*r^2 + l^2)                                        -->
  <!-- ========================================================================= -->
  <xacro:macro name="cylinder_inertia_y" params="m r l *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12.0) * (3.0*r*r + l*l)}" ixy="0.0" ixz="0.0"
               iyy="${0.5 * m * r*r}" iyz="0.0"
               izz="${(m/12.0) * (3.0*r*r + l*l)}"/>
    </inertial>
  </xacro:macro>

  <!-- ========================================================================= -->
  <!-- Inertial Macro: Solid Sphere                                              -->
  <!-- Radius: r, Mass: m                                                        -->
  <!-- Equations:                                                                -->
  <!--   Ixx = Iyy = Izz = (2/5) * m * r^2                                       -->
  <!-- ========================================================================= -->
  <xacro:macro name="sphere_inertia" params="m r *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${0.4 * m * r*r}" ixy="0.0" ixz="0.0"
               iyy="${0.4 * m * r*r}" iyz="0.0"
               izz="${0.4 * m * r*r}"/>
    </inertial>
  </xacro:macro>

</robot>
